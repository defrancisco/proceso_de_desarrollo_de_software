classDiagram
    %% Interfaz principal
    class Vendible {
        <<interface>>
        +getDescripcion() String
        +getPrecio() double
        +getStock() int
    }

    %% Componente Hoja (Composite)
    class ProductoSimple {
        -nombre: String
        -precio: double
        -stock: int
        +getDescripcion() String
        +getPrecio() double
        +getStock() int
    }

    %% Objeto Compuesto (Composite)
    class Combo {
        -nombreCombo: String
        -items: List~Vendible~
        +agregarItem(item: Vendible)
        +eliminarItem(item: Vendible)
        +getDescripcion() String
        +getPrecio() double
        +getStock() int
    }

    %% Decorador Base
    class VendibleDecorator {
        <<abstract>>
        #vendibleEnvuelto: Vendible
        +getDescripcion() String
        +getPrecio() double
        +getStock() int
    }

    %% Decoradores Concretos
    class DescuentoDecorator {
        -porcentajeDescuento: double
        +getDescripcion() String
        +getPrecio() double
    }

    class PackagingDecorator {
        -nombrePackaging: String
        -precioPackaging: double
        +getDescripcion() String
        +getPrecio() double
    }

    %% Relaciones de Implementación (Realization)
    ProductoSimple ..|> Vendible
    Combo ..|> Vendible
    VendibleDecorator ..|> Vendible

    %% Relaciones de Agregación (El rombo hueco)
    Combo o-- Vendible : contiene items
    VendibleDecorator o-- Vendible : envuelve a

    %% Relaciones de Herencia (Generalization)
    DescuentoDecorator --|> VendibleDecorator
    PackagingDecorator --|> VendibleDecorator